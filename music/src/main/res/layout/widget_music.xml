<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/w_art"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="#FF1F1F1F"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/w_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF9A9A9A"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_prev"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:padding="10dp"
        android:src="@drawable/i_prev" />

    <ImageView
        android:id="@+id/w_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#FFFFD60A"
        android:padding="12dp"
        android:src="@drawable/i_play"
        android:tint="#FF000000" />

    <ImageView
        android:id="@+id/w_next"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:padding="10dp"
        android:src="@drawable/i_next" />
</LinearLayout>
