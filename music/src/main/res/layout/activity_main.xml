<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E0E0E"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <!-- başlıq -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="18dp"
            android:paddingTop="14dp"
            android:paddingRight="8dp">

            <View
                android:layout_width="6dp"
                android:layout_height="26dp"
                android:layout_marginRight="10dp"
                android:background="#FFFFD60A" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="Lite Music"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_sleep"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:src="@drawable/i_timer" />

            <ImageView
                android:id="@+id/btn_eq"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:src="@drawable/i_eq" />

            <TextView
                android:id="@+id/btn_lang"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="EN"
                android:textColor="#FF9A9A9A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/search_bg"
            android:fontFamily="sans-serif-medium"
            android:hint="Mahnı, ifaçı, albom axtar…"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF9A9A9A"
            android:textSize="15sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/crumb"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#FF1F1F1F"
            android:drawablePadding="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingLeft="12dp"
            android:paddingRight="16dp"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:fastScrollEnabled="true"
                android:listSelector="@android:color/transparent"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="24dp"
                android:textColor="#FF9A9A9A"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- mini pleyer -->
        <LinearLayout
            android:id="@+id/mini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF1F1F1F"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/mini_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#FFFFD60A" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="6dp">

                <ImageView
                    android:id="@+id/mini_art"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="#FF2A2A2A"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="8dp">

                    <TextView
                        android:id="@+id/mini_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mini_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FF9A9A9A"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/mini_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#FFFFD60A"
                    android:padding="13dp"
                    android:src="@drawable/i_play" />

                <ImageView
                    android:id="@+id/mini_next"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="13dp"
                    android:src="@drawable/i_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- tam ekran pleyer -->
    <ScrollView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF0E0E0E"
        android:clickable="true"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingTop="8dp"
            android:paddingRight="22dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/p_close"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="9dp"
                    android:src="@drawable/i_down" />

                <TextView
                    android:id="@+id/p_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:text="İNDİ OXUNUR"
                    android:textColor="#FF9A9A9A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/p_queue"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/i_queue" />
            </LinearLayout>

            <ImageView
                android:id="@+id/p_art"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="14dp"
                android:background="#FF1F1F1F"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/p_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/p_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF9A9A9A"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/p_seek"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="18dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:progressDrawable="@drawable/seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb"
                android:thumbOffset="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/p_pos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FF9A9A9A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/p_dur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF9A9A9A"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/p_shuffle"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:padding="14dp"
                    android:src="@drawable/i_shuffle" />

                <ImageView
                    android:id="@+id/p_prev"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:padding="14dp"
                    android:src="@drawable/i_prev" />

                <ImageView
                    android:id="@+id/p_play"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="#FFFFD60A"
                    android:padding="22dp"
                    android:src="@drawable/i_play" />

                <ImageView
                    android:id="@+id/p_next"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:padding="14dp"
                    android:src="@drawable/i_next" />

                <ImageView
                    android:id="@+id/p_repeat"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:padding="14dp"
                    android:src="@drawable/i_repeat" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/p_fav"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:background="#FF1F1F1F"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="SEVİMLİ"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/p_sleep"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:background="#FF1F1F1F"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="TAYMER"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/p_eq"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="#FF1F1F1F"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="EKVALAYZER"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
